# ------------------------------------------------------------------ database
# PGlite keeps its files here. Override to point at another directory.
PGLITE_DIR=.data/pg

# A real PostgreSQL server (production). Leave blank to use embedded PGlite.
# DATABASE_URL=postgres://user:pass@host:5432/kiln

# -------------------------------------------------------------------- server
API_PORT=8787
NODE_ENV=development

# ------------------------------------------------------------------- secrets
# Signs download URLs. CHANGE THIS IN PRODUCTION — rotating it invalidates
# every outstanding download link.
STORAGE_SECRET=dev-only-insecure-storage-secret-change-me

# Private source-archive storage root. Must NOT be inside public/.
STORAGE_DIR=.data/storage

# ------------------------------------------------------------------- uploads
UPLOAD_MAX_ZIP_BYTES=209715200
UPLOAD_MAX_IMAGE_BYTES=8388608
UPLOAD_MAX_DOC_BYTES=26214400

# --------------------------------------------------------------------- owner
OWNER_EMAIL=owner@kiln.dev
OWNER_PASSWORD=kiln-owner-demo-2026
