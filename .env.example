# ------------------------------------------------------------------ database
# PGlite keeps its files here. Override to point at another directory.
PGLITE_DIR=.data/pg

# A real PostgreSQL server (recommended in production). Leave blank to use the
# embedded PGlite, which is single-writer and must be stopped for backups.
# DATABASE_URL=postgres://user:pass@host:5432/kiln

# -------------------------------------------------------------------- server
API_PORT=8787
NODE_ENV=development

# Public origin. Used in emails, payment callbacks, sitemap and canonical URLs.
# Must be the real https origin in production — never localhost.
PUBLIC_BASE_URL=http://localhost:5175

# Browser origins allowed to call the API with cookies (comma separated).
# Production: exactly your site. Anything absent is refused by CORS.
APP_ORIGINS=http://localhost:5175,http://localhost:5173

# Set true only when running behind a proxy/load balancer you control, so the
# left-most X-Forwarded-For entry is trusted for rate limiting.
# TRUST_PROXY=true

# ------------------------------------------------------------------- secrets
# Signs download URLs. CHANGE THIS IN PRODUCTION — the app refuses to boot in
# production with the default value. Generate with: openssl rand -hex 32
STORAGE_SECRET=dev-only-insecure-storage-secret-change-me

# Private source-archive storage root. Must NOT be inside public/.
STORAGE_DIR=.data/storage

# ------------------------------------------------------------------- uploads
UPLOAD_MAX_ZIP_BYTES=209715200
UPLOAD_MAX_IMAGE_BYTES=8388608
UPLOAD_MAX_DOC_BYTES=26214400

# -------------------------------------------------------------------- owner
# The first admin account, created by `npm run seed`.
OWNER_EMAIL=owner@kiln.dev
OWNER_PASSWORD=kiln-owner-demo-2026

# ----------------------------------------------------------------- payments
# Leave blank locally to use the sandbox gateway (never enabled in production).
# Without these in production, paid checkout is refused rather than faked.
# NOWPAYMENTS_API_KEY=
# NOWPAYMENTS_IPN_SECRET=
# NOWPAYMENTS_PAYOUT_WALLET=
# NOWPAYMENTS_MODE=live

# --------------------------------------------------------------------- mail
# Resend is used when RESEND_API_KEY is set. Otherwise messages are written to
# .data/mail.log and the server console (development log transport).
# MAIL_FROM=Kiln <receipts@your-domain.com>
# RESEND_API_KEY=
#
# Or bridge to your own SMTP relay over HTTP:
# SMTP_URL=https://relay.example.com/send
# SMTP_TOKEN=
