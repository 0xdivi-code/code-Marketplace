    "test:payments": "tsx server/scripts/test-payments.ts",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "test:journey": "tsx server/scripts/test-journey.ts",
    "test": "npm run typecheck && npm run test:payments",
    "seed": "tsx server/scripts/seed.ts",
    "reseed": "tsx server/scripts/reseed.ts",
    "migrate": "tsx server/scripts/migrate.ts",
