# Kiln — production environment.
#
# Install as /srv/kiln/.env with mode 600 (it holds secrets):
#   sudo install -m 600 -o kiln -g kiln deploy/kiln.env.example /srv/kiln/.env
#   sudo nano /srv/kiln/.env
#
# The API loads this file through `dotenv/config` from its working directory
# (/srv/kiln). Never commit the real file — .env is gitignored.

# ------------------------------------------------------------------ runtime
NODE_ENV=production
API_PORT=8787

# --------------------------------------------------------------- public urls
# The real https origin, no trailing slash. Used in emails, payment callbacks,
# sitemap and canonical tags. localhost here breaks every link you send.
PUBLIC_BASE_URL=https://kiln.example.com

# Browser origins allowed to call the API with cookies. Must match the origin
# above exactly, scheme included. Anything missing is refused by CORS.
APP_ORIGINS=https://kiln.example.com

# Caddy sets X-Forwarded-For; trust it so rate limits and audit rows record the
# real client address instead of 127.0.0.1.
TRUST_PROXY=true

# ------------------------------------------------------------------ storage
# Generate with: openssl rand -hex 32
# The app refuses to start in production with the placeholder value.
STORAGE_SECRET=replace-me-openssl-rand-hex-32

# Both directories MUST be on the persistent disk (see deploy/FREE-DEPLOY.md
# step 6). If they point inside the repo and you redeploy by wiping /srv/kiln,
# you delete the shop: database and every uploaded archive.
PGLITE_DIR=/var/lib/kiln/pg
STORAGE_DIR=/var/lib/kiln/storage

# Only used when mail falls back to the log transport; keeps it on the disk.
MAIL_LOG=/var/lib/kiln/mail.log

# Private archives must not be readable by other system users.
# chmod 700 /var/lib/kiln/storage

# -------------------------------------------------------------------- owner
# Created by `npm run seed` on first run. Change the password at first login.
OWNER_EMAIL=you@your-domain.com
OWNER_PASSWORD=use-a-long-unique-password

# ----------------------------------------------------------------- payments
# Without these two, paid checkout is refused in production rather than faked.
# IPN URL in the NOWPayments dashboard:
#   https://kiln.example.com/api/webhooks/nowpayments
# NOWPAYMENTS_API_KEY=
# NOWPAYMENTS_IPN_SECRET=
# NOWPAYMENTS_PAYOUT_WALLET=
# NOWPAYMENTS_MODE=live

# --------------------------------------------------------------------- mail
# Without RESEND_API_KEY mail goes to MAIL_LOG and the console, and Admin →
# Notifications says "Development log". Set this before selling anything.
# MAIL_FROM=Kiln <receipts@your-domain.com>
# RESEND_API_KEY=

